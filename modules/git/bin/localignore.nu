#!/usr/bin/env nu
# git localignore: show only the parts of a repo you care about.
#
# Writes a generated block to .git/info/exclude (a local gitignore that's never
# committed). Everything is ignored except:
#   - files and directories you pick, with everything inside them
#     (repo-relative paths in git config --local localignore.path)
#   - parent directories of files changed on this branch
#
# Commands:
#   git localignore                 pick visible paths with fzf, then apply
#   git localignore update          regenerate (for hooks / after branch switches)
#   git localignore hooks           install post-checkout/merge/commit/rewrite hooks
#   git localignore off             remove the generated block (show everything)
#
# Config (all optional, per repo; global/system config is ignored):
#   git config --local --add localignore.path apps/web/handover   # same as picking it
#   git config --local localignore.base develop   # default: origin/HEAD, then main

const BLOCK_START = "# >>> git-localignore: generated, edits inside this block are overwritten >>>"
const BLOCK_END = "# <<< git-localignore <<<"
const LEGACY_HEADER = "# Generated by gitignore-whitelist.nu"
const LINK = ".gitignore.local"
const HOOKS = [post-checkout post-merge post-commit post-rewrite]
const HOOK_LINE = "git localignore update --quiet || true"

# ---------------------------------------------------------------- helpers ----

# Run a git subcommand with -z so paths with spaces/unicode come through unquoted
def --wrapped git-paths [subcommand: string, ...args: string] {
  ^git $subcommand -z ...$args | split row (char nul) | where $it != ""
}

# All settings are per-repo: only .git/config is read, never global/system config
def config-values [key: string] {
  let r = do { ^git config --local --get-all $key } | complete
  if $r.exit_code == 0 { $r.stdout | lines | where $it != "" } else { [] }
}

def regex-escape []: string -> string {
  str replace --all --regex '([.^$*+?()\[\]{}|\\])' '\$1'
}

# Escape characters with special meaning in gitignore patterns
def pattern-escape []: string -> string {
  str replace --all --regex '([*?\[\]\\])' '\$1'
}

def exclude-file [] { ^git rev-parse --git-path info/exclude | str trim }

def --env enter-repo [] {
  let r = do { ^git rev-parse --show-toplevel } | complete
  if $r.exit_code != 0 { error make --unspanned {msg: "Not inside a Git work tree"} }
  cd ($r.stdout | str trim)
}

def log [quiet: bool, msg: string] { if not $quiet { print $msg } }

# ------------------------------------------------------------------ setup ----

# Make sure info/exclude exists and .gitignore.local links to it
def ensure-setup [quiet: bool] {
  let file = exclude-file
  mkdir ($file | path dirname)
  if not ($file | path exists) { "" | save $file }

  # Ignore the symlink itself, outside the generated block so it survives `off`
  let lines = open --raw $file | lines | str trim
  if not ($lines | any {|l| $l in [$LINK $"/($LINK)"] }) {
    let text = open --raw $file
    let sep = if ($text | is-empty) or ($text | str ends-with "\n") { "" } else { "\n" }
    $"($sep)/($LINK)\n" | save --append $file
  }

  if not ($LINK | path exists --no-symlink) {
    ^ln -s $file $LINK
    log $quiet $"Linked ($LINK) -> ($file)"
  } else if ($LINK | path type) != symlink {
    print -e $"warning: ($LINK) exists and isn't a symlink; leaving it alone"
  } else if ($LINK | path expand) != ($file | path expand) {
    print -e $"warning: ($LINK) points to (^readlink $LINK | str trim), not ($file)"
  }
}

# Replace the generated block at the top of info/exclude, keeping your own rules
def write-block [lines: list<string>] {
  let file = exclude-file
  let existing = if ($file | path exists) { open --raw $file } else { "" }
  let rest = if ($existing | str starts-with $LEGACY_HEADER) {
    ""  # output of the old standalone script: the whole file was generated
  } else {
    let re = $"\(?s)($BLOCK_START | regex-escape).*?($BLOCK_END | regex-escape)\\n?"
    $existing | str replace --regex $re ""
  }
  let block = if ($lines | is-empty) { "" } else {
    ([$BLOCK_START ...$lines $BLOCK_END] | str join "\n") + "\n"
  }
  $block + $rest | save --force $file
}

# ------------------------------------------------------------------ rules ----

def repo-files [] {
  # Untracked files honour .gitignore and your global excludes, but NOT
  # info/exclude, since that's our output
  let global = do { ^git config --path core.excludesFile } | complete
  let global_file = if $global.exit_code == 0 { $global.stdout | str trim } else {
    ($env.XDG_CONFIG_HOME? | default ($env.HOME | path join .config)) | path join git ignore
  }
  let extra = if ($global_file | path exists) { [$"--exclude-from=($global_file)"] } else { [] }
  let untracked = git-paths ls-files --others --exclude-per-directory=.gitignore ...$extra
    | where $it != $LINK
  {tracked: (git-paths ls-files --cached), untracked: $untracked}
}

def resolve-base [flag] {
  let configured = config-values localignore.base
  let base = if $flag != null { $flag } else if ($configured | is-not-empty) { $configured | last } else {
    let r = do { ^git rev-parse --abbrev-ref origin/HEAD } | complete
    if $r.exit_code == 0 { $r.stdout | str trim } else { "main" }
  }
  let mb = do { ^git merge-base HEAD $base } | complete
  {base: $base, merge_base: (if $mb.exit_code == 0 { $mb.stdout | str trim } else { null })}
}

# Paths shown without being picked: parents of changed files
def auto-targets [files: record, base: record] {
  # Committed since the merge-base, staged, unstaged; falls back to HEAD
  let ref = $base.merge_base | default HEAD
  let diff = do { ^git diff -z --name-only $ref } | complete
  let changed = if $diff.exit_code == 0 {
    $diff.stdout | split row (char nul) | where $it != ""
  } else { [] }
  let parents = $changed ++ $files.untracked
    | each {|f| let p = $f | path dirname; if $p == "" { $f } else { $p } }

  $parents | uniq
}

def rules-for [targets: list<string>] {
  let all = $targets | uniq | where ($it | path exists) | sort

  # Drop targets inside another directory target; otherwise the inner target's
  # `/parent/*` rule would hide the rest of the outer directory
  let dirs = $all | where ($it | path type) == dir
  let kept = $all | where {|t| not ($dirs | any {|d| $t | str starts-with $"($d)/" }) }

  # Un-ignore every ancestor and re-ignore its other contents, then un-ignore
  # the target. Dedupe keeps first occurrences, so each `/a/*` stays ahead of
  # the `!/a/...` lines that depend on it.
  let rules = $kept
    | each {|t|
        let parts = $t | path split
        let ancestors = 1..<($parts | length) | each {|n| $parts | first $n | path join | pattern-escape }
        let suffix = if ($t | path type) == dir { "/" } else { "" }
        let chain = $ancestors | each {|a| [$"!/($a)/" $"/($a)/*"] } | flatten
        $chain ++ [$"!/($t | pattern-escape)($suffix)"]
      }
    | flatten
    | uniq
  {visible: ($kept | length), lines: (["/*"] ++ $rules)}
}

def apply [base_flag, dry_run: bool, quiet: bool] {
  ensure-setup $quiet
  let base = resolve-base $base_flag
  if $base.merge_base == null {
    print -e $"warning: no merge-base with '($base.base)', only showing uncommitted changes. Set one with --base or `git config --local localignore.base <branch>`"
  }
  let files = repo-files
  let picked = config-values localignore.path
  let rules = rules-for ((auto-targets $files $base) ++ $picked)
  if ($picked | is-empty) and not $quiet {
    print -e "note: no paths picked, so only parents of changed files are visible. Run `git localignore` to pick some"
  }

  if $dry_run {
    print ($rules.lines | str join "\n")
  } else {
    write-block $rules.lines
    log $quiet $"Updated (exclude-file): ($rules.visible) visible paths"
  }
}

# --------------------------------------------------------------- commands ----

# Pick which directories and files stay visible, using fzf
def main [
  --base: string  # Branch to diff against (default: localignore.base, origin/HEAD, main)
] {
  enter-repo
  if (which fzf | is-empty) { error make --unspanned {msg: "fzf not found in PATH"} }
  ensure-setup false

  let files = repo-files
  let all_files = $files.tracked ++ $files.untracked
  let picked = config-values localignore.path
  let auto = auto-targets $files (resolve-base $base)

  let dirs = $all_files
    | path dirname
    | where $it != ""
    | uniq
    | each {|d| let parts = $d | path split; 1..($parts | length) | each {|n| $parts | first $n | path join } }
    | flatten
    | uniq
    | sort

  # Picked first, then automatic, then directories, then files
  let entries = ($dirs | each {|d| {path: $d, display: $"($d)/"} }) ++ ($all_files | sort | each {|f| {path: $f, display: $f} })
    | each {|e|
        let rank = if $e.path in $picked { 0 } else if $e.path in $auto { 1 } else { 2 }
        $e | insert rank $rank | insert mark (["✓" "·" " "] | get $rank)
      }
    | sort-by rank

  let header = [
    "TAB toggle · ENTER apply · ESC cancel"
    "✓ picked (pick again to hide) · · parent of a changed file"
  ] | str join "\n"
  let preview = 'p={2}; if [ -d "$p" ]; then ls -Ap "$p"; else head -n 200 "$p"; fi'

  let input = $entries | each {|e| $"($e.mark)\t($e.display)" } | str join "\n"
  # SHELL=sh so fzf runs the preview with sh even if your login shell is nu
  let out = try {
    with-env {SHELL: "sh"} {
      $input | ^fzf --multi --delimiter "\t" --nth 2 --prompt "localignore> " --header $header --preview $preview --preview-window "right,50%,border-left"
    }
  } catch { return }  # ESC or no match

  let chosen = $out | lines | where $it != "" | each { split row "\t" | get 1 | str trim --right --char "/" }
  let removed = $chosen | where $it in $picked
  let added = $chosen | where $it not-in $picked
  let new = ($picked | where $it not-in $removed) ++ $added | uniq

  do { ^git config --local --unset-all localignore.path } | complete | ignore
  for p in $new { ^git config --local --add localignore.path $p }

  for p in $added { print $"(ansi green)+ ($p)(ansi reset)" }
  for p in $removed { print $"(ansi red)- ($p)(ansi reset)" }
  apply $base false false
}

# Regenerate the ignore rules from config and current branch changes
def "main update" [
  --base: string  # Branch to diff against
  --dry-run       # Print the rules instead of writing them
  --quiet         # Only print warnings
] {
  enter-repo
  apply $base $dry_run $quiet
}

# Install hooks that run `git localignore update` after checkouts, merges, commits and rebases
def "main hooks" [] {
  enter-repo
  let custom = do { ^git config core.hooksPath } | complete
  if $custom.exit_code == 0 {
    print -e $"core.hooksPath is set to ($custom.stdout | str trim), probably shared hooks; not touching it."
    print -e $"Add this line to your ($HOOKS | str join ', ') hooks:\n  ($HOOK_LINE)"
    return
  }
  let dir = ^git rev-parse --git-path hooks | str trim
  mkdir $dir
  for h in $HOOKS {
    let f = $dir | path join $h
    if not ($f | path exists) {
      $"#!/bin/sh\n($HOOK_LINE)\n" | save $f
      ^chmod +x $f
      print $"Created ($f)"
    } else if not (open --raw $f | str contains $HOOK_LINE) {
      $"\n($HOOK_LINE)\n" | save --append $f
      print $"Appended to ($f)"
    }
  }
}

# Remove the generated rules so everything is visible again (config is kept)
def "main off" [] {
  enter-repo
  write-block []
  print $"Removed generated rules from (exclude-file); run `git localignore update` to restore"
}
